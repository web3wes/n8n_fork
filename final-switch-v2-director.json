      "position": [
        400,
        300
      ],
      "parameters": {
        "model": "text-davinci-003",
        "prompt": "Analyze the complexity of the following request: {{$json[\"body\"]}}",
        "maxTokens": 50,
        "resource": "text",
        "operation": "complete",
        "options": {}
      }
    },
    {
      "id": "3",
