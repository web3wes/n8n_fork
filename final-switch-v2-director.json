      "typeVersion": 1,
      "position": [
        600,
        300
      ],
      "parameters": {
        "property": "data.complexity",
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value2": "simple",
              "outputKey": "Output 1"
            },
            {
              "operation": "equal",
              "value2": "moderate",
              "outputKey": "Output 2"
            },
            {
              "operation": "equal",
              "value2": "complex",
              "outputKey": "Output 3"
            }
          ]
        },
        "mode": "rules",
        "dataType": "string",
        "value1": "={{ $json.complexity }}",
        "options": {}
      }
    },
    {
