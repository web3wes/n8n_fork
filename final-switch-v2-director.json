{
  "name": "Request Complexity Routing Workflow",
  "active": false,
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "path": "request-complexity",
        "method": "POST",
        "responseMode": "responseNode",
        "httpMethod": "GET",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "OpenAI",
