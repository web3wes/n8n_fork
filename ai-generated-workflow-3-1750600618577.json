{
  "name": "Customer Support Ticket Routing Workflow",
  "active": false,
  "nodes": [
    {
      "id": "1",
      "name": "Read Support Emails",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "mailbox": "INBOX",
        "email": "support@example.com",
        "password": "your-email-password",
        "host": "imap.example.com",
        "port": 993,
        "secure": true,
        "user": "support@example.com",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Analyze Email Content",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        400,
        300
      ],
      "parameters": {
        "model": "text-davinci-003",
        "prompt": "Classify the following email content into categories: Billing, Technical Support, General Inquiry. Email content: {{$json[\"text\"]}}",
        "maxTokens": 50,
        "resource": "text",
        "operation": "complete",
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Route Ticket",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        600,
        300
      ],
      "parameters": {
        "property": "data",
        "rules": {
          "rules": [
            {
              "value2": "Billing"
            },
            {
              "value2": "Technical Support"
            },
            {
              "value2": "General Inquiry"
            }
          ]
        },
        "dataType": "string",
        "value1": "={{ $json.complexity }}",
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Send to Billing",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        800,
        200
      ],
      "parameters": {
        "fromEmail": "support@example.com",
        "toEmail": "billing@example.com",
        "subject": "New Billing Support Ticket",
        "text": "A new billing support ticket has been received. Please review the details.",
        "options": {}
      }
    },
    {
      "id": "5",
      "name": "Send to Technical Support",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        800,
        300
      ],
      "parameters": {
        "fromEmail": "support@example.com",
        "toEmail": "techsupport@example.com",
        "subject": "New Technical Support Ticket",
        "text": "A new technical support ticket has been received. Please review the details.",
        "options": {}
      }
    },
    {
      "id": "6",
      "name": "Send to General Inquiry",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        800,
        400
      ],
      "parameters": {
        "fromEmail": "support@example.com",
        "toEmail": "info@example.com",
        "subject": "New General Inquiry",
        "text": "A new general inquiry has been received. Please review the details.",
        "options": {}
      }
    }
  ],
  "connections": {
    "Read Support Emails": {
      "main": [
        [
          {
            "node": "Analyze Email Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Email Content": {
      "main": [
        [
          {
            "node": "Route Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Ticket": {
      "main": [
        [
          {
            "node": "Send to Billing",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send to Technical Support",
            "type": "main",
            "index": 1
          }
        ],
        [
          {
            "node": "Send to General Inquiry",
            "type": "main",
            "index": 2
          }
        ]
      ]
    }
  },
  "settings": {},
  "meta": {
    "instanceId": "text-to-workflow-generated"
  },
  "tags": [
    "text-to-workflow"
  ],
  "requiredCredentials": [
    "emailImap",
    "openAi"
  ],
